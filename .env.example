# Copy to .env and fill in. Never commit .env.

# Provider: "openrouter" (course default) or "deepseek" (DeepSeek official API).
# LLM_PROVIDER is preferred; CS329Z_LM_PROVIDER is accepted as a fallback.
LLM_PROVIDER=deepseek

# --- DeepSeek official API ---
DEEPSEEK_API_KEY=
# Optional override; default is https://api.deepseek.com
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Thinking mode: disabled (default) or enabled
# DEEPSEEK_THINKING=disabled

# --- OpenRouter (kept for the original course path) ---
OPENROUTER_API_KEY=

# Model names. With LLM_PROVIDER=deepseek and these unset, LM() uses deepseek-flash.
CS329Z_GRADING_MODEL=deepseek-flash
CS329Z_USER_MODEL=deepseek-flash
CS329Z_JUDGE_MODEL=deepseek-flash

# Optional overrides
# CS329Z_REASONING_EFFORT=low   # OpenRouter reasoning models only; not sent to DeepSeek
# CS329Z_BUDGET_USD=25          # stop new paid calls once ledger cost_usd reaches this
# CS329Z_CNY_PER_USD=7.2        # convert DeepSeek CNY list prices into estimated ledger USD
# CS329Z_EVAL_SLICE=5           # run live tests on the first N items only
